{
  "name": "taskflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:migrate": "bun db/migrate.ts",
    "db:seed": "bun db/seed.ts",
    "db:reset": "bun db/reset.ts"
  },
  "dependencies": {
    "remix": "^3.0.0-beta.10"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@types/bun": "^1.4.0",
    "@types/node": "latest",
    "oxfmt": "^0.65.0",
    "typescript": "latest"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.3.0"
  }
}
